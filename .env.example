DJANGO_VITE_DEV_SERVER_PORT=5173

# Inertia SSR
INERTIA_SSR_ENABLED=False
INERTIA_SSR_URL=http://localhost:13714

# OpenAI
OPENAI_API_KEY=sk-...
INTEGRACAR_CHAT_MODEL=gpt-6-luna
